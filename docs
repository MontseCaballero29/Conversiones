package conversiones;

/**

La clase Convertir proporciona métodos estáticos para realizar conversiones

entre diferentes unidades de medida. Esta clase ofrece funcionalidades para

convertir unidades de masa, tiempo, velocidad, fuerza, energía, potencia,

presión y frecuencia, así como utilidades para validación de texto.

@author Crespo Castañón Suyay Fernanda

@author Caballero Silva Dalia Montserrat */ 
public class Convertir {

// Constantes public static final double constanteKilogramos = 1000; // Toneladas a kilogramos public static final double constanteKilogramosLibras = 0.453592; // Libras a kilogramos public static final double constanteOnzas = 28.3495; // Onzas a gramos public static final double constanteSegundosM = 60; // Segundos en un minuto public static final double constanteSegundosH = 3600; // Segundos en una hora public static final double constanteSegundosD = 86400; // Segundos en un día public static final double MPH = 0.2778; // Km/h a m/s public static final double KMH = 1.60934; // mph a km/h public static final double gravedad = 9.81; // Gravedad terrestre public static final double N = 4.44822; // Libras-fuerza a newtons public static final double Jul = 4.184; // Calorías a julios public static final double eVJ = 1.602e-19; // Electrón-voltios a julios public static final double Vatio = 746; // hp a vatios public static final double Pascalatm = 101325; // atm a pascales public static final double Pascalbar = 100000; // bar a pascales public static final double MHzHz = 1000000; // MHz a Hz public static final double grados = 180 / Math.PI; // Radianes a grados

/**

Método principal para la ejecución de la aplicación.

@param args Argumentos de línea de comandos */ 
  public static void main(String[] args) { // Aquí va la lógica principal si se desea ejecutar algo }


/**

Convierte toneladas a kilogramos.

@param num Cantidad en toneladas

@return Equivalente en kilogramos */
    public static double ToneladasKilogramos(double num) { return num * constanteKilogramos; }


/**

Convierte libras a kilogramos.

@param num Cantidad en libras

@return Equivalente en kilogramos */
    public static double LibrasKilogramos(double num) { return num * constanteKilogramosLibras; }


/**

Convierte onzas a gramos.

@param num Cantidad en onzas

@return Equivalente en gramos */
    public static double OnzasGramos(double num) { return num * constanteOnzas; }


/**

Convierte minutos a segundos.

@param tiempo Cantidad en minutos

@return Equivalente en segundos */ 
    public static double MinutosSegundos(double tiempo) { return tiempo * constanteSegundosM; }


/**

Convierte horas a segundos.

@param tiempo Cantidad en horas

@return Equivalente en segundos */ 
    public static double HorasSegundos(double tiempo) { return tiempo * constanteSegundosH; }


/**

Convierte días a segundos.

@param tiempo Cantidad en días

@return Equivalente en segundos */ 
    public static double DiaSegundos(double tiempo) { return tiempo * constanteSegundosD; }


/**

Convierte km/h a m/s.

@param velocidad Velocidad en km/h

@return Velocidad en m/s */
    public static double KmporhoraMporsegundo(double velocidad) { return velocidad * MPH; }


/**

Convierte mph a km/h.

@param velocidad Velocidad en mph

@return Velocidad en km/h */ 
    public static double MPHaKMH(double velocidad) { return velocidad * KMH; }


/**

Convierte unidades de g a m/s².

@param g Valor en unidades de gravedad terrestre

@return Equivalente en m/s² */ 
    public static double Aceleracion(double g) { return g * gravedad; }


/**

Convierte libras-fuerza a newtons.

@param libras Fuerza en libras-fuerza

@return Equivalente en newtons */ 
    public static double LibrasFuerzaNewtons(double libras) { return libras * N; }


/**

Convierte calorías a julios.

@param cal Energía en calorías

@return Equivalente en julios */ 
    public static double CalJul(double cal) { return cal * Jul; }


/**

Convierte electrón-voltios a julios.

@param eV Energía en electrón-voltios

@return Equivalente en julios */
    public static double eVJul(double eV) { return eV * eVJ; }


/**

Convierte hp a vatios.

@param hp Potencia en hp

@return Equivalente en vatios */ 
    public static double hpVatio(double hp) { return hp * Vatio; }


/**

Convierte atmósferas a pascales.

@param atm Presión en atmósferas

@return Equivalente en pascales */
    public static double atmPa(double atm) { return atm * Pascalatm; }


/**

Convierte bares a pascales.

@param bar Presión en bares

@return Equivalente en pascales */
    public static double barPa(double bar) { return bar * Pascalbar; }


/**

Convierte MHz a Hz.

@param MHz Frecuencia en MHz

@return Equivalente en Hz */ 
    public static double MHzaHz(double MHz) { return MHz * MHzHz; }


/**

Convierte radianes a grados.

@param rad Ángulo en radianes

@return Equivalente en grados */ 
    public static double RadGrados(double rad) { return rad * grados; }


/**

Verifica si un texto contiene solo dígitos.

@param texto Cadena de texto a verificar

@return true si solo contiene dígitos, false en caso contrario */ 
    public static boolean soloContieneDígitos(String texto) { return texto.matches("\d+"); } }

